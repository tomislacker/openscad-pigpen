# Intermediates: everything under build/ is regenerated by `make` from
# pigpen_logo.svg. The finished artefacts live in dist/ and *are* committed.
/build/

# Python bytecode. tools/ is only ever run as scripts, so these are pure
# byproducts and must never be committed.
__pycache__/
*.py[cod]

# OpenSCAD GUI leftovers
*.stl
*.csg
.*.scad

# ...except the exported models, which are committed so that GitHub can render
# them and so nobody needs Inkscape + potrace just to print the thing.
!/dist/stl/*.stl
