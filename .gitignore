# Intermediates: everything under build/ is regenerated by `make` from
# pigpen_logo.xcf. The finished artefacts live in dist/ and *are* committed.
/build/

# Python bytecode. tools/ is only ever run as scripts, so these are pure
# byproducts of importing a tool (the test for keyhole_area does) and must never
# be committed.
__pycache__/
*.py[cod]

# OpenSCAD GUI leftovers
*.stl
*.csg
.*.scad

# ...except the exported models, which are committed so that GitHub can render
# them and so nobody needs GIMP + potrace just to print the thing.
!/dist/stl/*.stl
